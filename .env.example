# -----------------------------------------------------------------------------
# KernHell Environment Configuration
# -----------------------------------------------------------------------------

# Google Gemini API Key (Recommended)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Alternatively use Groq / OpenAI / Anthropic
# GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Override Provider & Model if needed (defaults to gemini / gemini-1.5-flash)
# KERNHELL_LLM__PROVIDER=gemini
# KERNHELL_LLM__MODEL=gemini-1.5-flash
